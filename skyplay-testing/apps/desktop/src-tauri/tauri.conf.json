{
  "productName": "SkyPlay Desktop",
  "version": "0.1.0",
  "identifier": "com.skyplay.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "SkyPlay Desktop",
        "width": 960,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/retroarch-windows/**",
      "binaries/retroarch-macos/**",
      "binaries/retroarch-linux/**",
      "binaries/cores/**"
    ]
  }
}
