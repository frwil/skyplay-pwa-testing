# Copy to .env.prod on the VPS and fill in. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod

# Public hostname pointing (DNS A record) to this VPS's public IP.
# Caddy provisions a Let's Encrypt cert for it and serves wss:// on 443.
# This exact value (with wss:// prefix) becomes GAME_SERVER_PUBLIC_URL on Vercel.
DOMAIN=game.your-domain.com

# Optional: email for Let's Encrypt expiry notices. Leave empty to skip.
TLS_EMAIL=

# Must match the token the Next.js stats/recording endpoints expect.
# (Currently "dev" — harden later on both sides.)
STATS_API_TOKEN=dev
